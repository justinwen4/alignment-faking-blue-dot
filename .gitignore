# Environment
.env

# Data & results (large / generated)
data/synthetic_docs/**/*
!data/synthetic_docs/**/
!data/synthetic_docs/**/.gitkeep
data/fine_tune/**/*
!data/fine_tune/**/
!data/fine_tune/**/.gitkeep
data/elicitation/**/*
!data/elicitation/**/
!data/elicitation/**/.gitkeep
data/validation/**/*
!data/validation/**/
!data/validation/**/.gitkeep
results/**/*
!results/**/
